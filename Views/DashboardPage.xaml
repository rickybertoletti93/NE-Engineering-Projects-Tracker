<Page x:Class="DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#11161D">

    <Page.Resources>

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#11161D"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#171D25"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A313C"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B222C"/>
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#202733"/>
        <SolidColorBrush x:Key="SoftPanelBrushAlt" Color="#1D232D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A2B3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D90429"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#232B36"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#1D232D"/>
            <Setter Property="BorderBrush" Value="#313845"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#232B36"/>
                    <Setter Property="BorderBrush" Value="#465062"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#171D25"/>
            <Setter Property="AlternatingRowBackground" Value="#1B222C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#232B36"/>
            <Setter Property="VerticalGridLinesBrush" Value="#232B36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202733"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#2A313C"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="WidgetTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WidgetValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SubSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LegendDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,6,0,0"
                                   Text="Overview rapido dello stato documentale e delle ultime attività."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Total Documents" Style="{StaticResource WidgetTitleStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Margin="0,12,0,0"
                                       Text="{Binding TotalDocuments}"
                                       Style="{StaticResource WidgetValueStyle}"/>
                            <TextBlock Grid.Row="2"
                                       Margin="0,14,0,0"
                                       Text="Tutti i documenti presenti nella lista"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Documents Issued" Style="{StaticResource WidgetTitleStyle}"/>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DocumentsIssued}"
                                           Style="{StaticResource WidgetValueStyle}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding DocumentsIssuedPercentage, StringFormat={}{0:F1}% del totale}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <ProgressBar Grid.Row="2"
                                         Margin="0,16,0,0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DocumentsIssuedPercentage}"
                                         Foreground="{StaticResource SuccessBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" BorderBrush="Transparent"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="In Progress" Style="{StaticResource WidgetTitleStyle}"/>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="{Binding InProgressDocuments}"
                                           Style="{StaticResource WidgetValueStyle}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding InProgressPercentage, StringFormat={}{0:F1}% del totale}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <ProgressBar Grid.Row="2"
                                         Margin="0,16,0,0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InProgressPercentage}"
                                         Foreground="{StaticResource WarningBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" BorderBrush="Transparent"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Overdue" Style="{StaticResource WidgetTitleStyle}"/>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="{Binding OverdueDocuments}"
                                           Style="{StaticResource WidgetValueStyle}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding OverduePercentage, StringFormat={}{0:F1}% del totale}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <ProgressBar Grid.Row="2"
                                         Margin="0,16,0,0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding OverduePercentage}"
                                         Foreground="{StaticResource DangerBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" BorderBrush="Transparent"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Overall Status" Style="{StaticResource SubSectionTitleStyle}"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="240" Height="240" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Fill="#1D232D" Stroke="#2A313C" StrokeThickness="1"/>

                                    <Canvas Width="240" Height="240">
                                        <Path Data="{Binding IssuedSliceGeometry}" Fill="{StaticResource SuccessBrush}" Stretch="None"/>
                                        <Path Data="{Binding InProgressSliceGeometry}" Fill="{StaticResource WarningBrush}" Stretch="None"/>
                                        <Path Data="{Binding OverdueSliceGeometry}" Fill="{StaticResource DangerBrush}" Stretch="None"/>
                                        <Path Data="{Binding RemainingSliceGeometry}" Fill="{StaticResource AccentBrush}" Stretch="None"/>
                                    </Canvas>

                                    <Ellipse Width="110" Height="110"
                                             Fill="{StaticResource CardBackgroundBrush}"
                                             Stroke="#2A313C"
                                             StrokeThickness="1"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalDocuments}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="24"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Documents"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Padding="14" Margin="0,0,0,12" CornerRadius="14" Background="{StaticResource SoftPanelBrushAlt}" BorderBrush="#2A313C" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="Total" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalDocuments}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <Border Padding="14" Margin="0,0,0,12" CornerRadius="14" Background="{StaticResource SoftPanelBrushAlt}" BorderBrush="#2A313C" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource SuccessBrush}"/>
                                                <TextBlock Text="Issued" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DocumentsIssuedPercentage, StringFormat={}{0:F1}%}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <Border Padding="14" Margin="0,0,0,12" CornerRadius="14" Background="{StaticResource SoftPanelBrushAlt}" BorderBrush="#2A313C" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource WarningBrush}"/>
                                                <TextBlock Text="In Progress" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding InProgressPercentage, StringFormat={}{0:F1}%}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <Border Padding="14" CornerRadius="14" Background="{StaticResource SoftPanelBrushAlt}" BorderBrush="#2A313C" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource DangerBrush}"/>
                                                <TextBlock Text="Overdue" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding OverduePercentage, StringFormat={}{0:F1}%}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Latest Document Activity" Style="{StaticResource SubSectionTitleStyle}"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text=" (Latest 3)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding LatestActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14"
                                                Padding="16"
                                                CornerRadius="16"
                                                Background="{StaticResource SoftPanelBrushAlt}"
                                                BorderBrush="#2A313C"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="42" Height="42"
                                                        CornerRadius="21"
                                                        Background="#2E1A1F"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding ShortAction}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding DocumentNumber}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"/>
                                                    </DockPanel>


                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Border Padding="8,4"
                                                                Background="#1D232D"
                                                                BorderBrush="#2A313C"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>